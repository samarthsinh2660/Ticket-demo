// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  EMPLOYEE
}

enum TicketStatus {
  TO_DO
  IN_PROGRESS
  DONE
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  BUG
  FEATURE_REQUEST
  SUPPORT
  BILLING
  TECHNICAL
  OTHER
}

model User {
  id              Int           @id @default(autoincrement())
  email           String        @unique
  password        String
  name            String
  role            Role
  department      String?
  status          String        @default("ACTIVE") // ACTIVE or INACTIVE
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Relations
  ticketsCreated  Ticket[]      @relation("CustomerTickets")
  ticketsAssigned Ticket[]      @relation("AssigneeTickets")
  activityLogs    ActivityLog[]

  @@map("users")
}

model Ticket {
  id           Int            @id @default(autoincrement())
  ticketNumber String         @unique
  title        String
  description  String
  status       TicketStatus   @default(TO_DO)
  priority     TicketPriority @default(MEDIUM)
  category     TicketCategory
  dueDate      DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Foreign keys
  customerId   Int
  assigneeId   Int?

  // Relations
  customer     User           @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Cascade)
  assignee     User?          @relation("AssigneeTickets", fields: [assigneeId], references: [id], onDelete: SetNull)
  activityLogs ActivityLog[]

  @@map("tickets")
}

// ActivityLog model for keeping track of ticket actions and comments/replies
model ActivityLog {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  userId    Int
  action    String
  details   String?
  createdAt DateTime @default(now())

  // Relations
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}
